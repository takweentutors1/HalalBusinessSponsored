# Copy to .dev.vars (gitignored) and fill in real values for local dev.
# Production values are set via `wrangler secret put <NAME>` — never committed.

# Cloudflare Turnstile secret key. Optional locally — app/api/apply/route.ts
# falls back to Cloudflare's public "always passes" test secret when unset.
TURNSTILE_SECRET_KEY=

# Public site key read at build/runtime via NEXT_PUBLIC_TURNSTILE_SITE_KEY
# (see lib/config.ts). Optional locally — falls back to the matching public
# test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Hostinger (Titan Mail) SMTP — optional locally, sending is skipped (not
# faked) when unset. See lib/email/client.ts.
HOSTINGER_SMTP_HOST=
HOSTINGER_SMTP_PORT=
HOSTINGER_SMTP_USER=
HOSTINGER_SMTP_PASSWORD=
TEAM_NOTIFICATION_EMAIL=

# Admin login (/admin/login, see lib/admin/auth.ts). REQUIRED — unlike the
# others above, there's no safe fallback; login always rejects until both
# are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional — signs the session cookie. Falls back to ADMIN_PASSWORD if unset.
ADMIN_SESSION_SECRET=
