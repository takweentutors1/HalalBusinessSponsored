# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
.open-next/
.wrangler/
# worker-configuration.d.ts is committed (not ignored) — Cloudflare Workers
# Builds does a fresh checkout with no prior `wrangler types` run, and
# next build's TypeScript check needs CloudflareEnv (env.DB etc.) to
# resolve at that point. Regenerate with `npm run cf-typegen` after
# changing wrangler.jsonc bindings and commit the result.
